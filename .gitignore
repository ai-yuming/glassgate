# Runtime trace artifacts — JSONL is the source of truth but instance logs are
# not versioned; the SQLite index is always rebuildable from JSONL.
logs/*.jsonl
logs/*.db
logs/ledger-cache.json

# Generated glass wall (single-file HTML output — regenerate with `harness wall`)
glasswall/*.html

# Python
__pycache__/
*.pyc
.pytest_cache/

# Playwright MCP verification artifacts
.playwright-mcp/
